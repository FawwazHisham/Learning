# ── AI Provider Keys ──────────────────────────────────────────────
OPENAI_API_KEY=sk-...
ANTHROPIC_API_KEY=sk-ant-...

# ── Database ──────────────────────────────────────────────────────
DATABASE_URL=sqlite:///./agent_db.sqlite
# For PostgreSQL: postgresql+asyncpg://user:password@localhost/dbname

# ── Redis ─────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ── App Settings ──────────────────────────────────────────────────
APP_ENV=development
LOG_LEVEL=DEBUG
